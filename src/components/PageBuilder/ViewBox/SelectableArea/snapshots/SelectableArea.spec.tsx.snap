// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SelectableArea snapshots > should not render SelectableArea 1`] = `<DocumentFragment />`;

exports[`SelectableArea snapshots > should render SelectableArea 1`] = `
<DocumentFragment>
  <div
    class="SelectableArea"
  >
    <svg
      class="SelectableArea__area"
    >
      <path
        d="M 0,0 H 0 V 0 H 0 V 0"
      />
    </svg>
  </div>
</DocumentFragment>
`;
